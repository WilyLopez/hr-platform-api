# ─────────────────────────────────────────────────────────────────────────────
# NexusRH — Plantilla de entorno para PRODUCCIÓN
# Copia este archivo como .env.production y llena los valores reales.
# NUNCA subas el archivo con valores reales al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# Django
SECRET_KEY=CAMBIA_ESTO_POR_UNA_CLAVE_ALEATORIA_LARGA_Y_SEGURA
DEBUG=False
ALLOWED_HOSTS=tudominio.com,www.tudominio.com
DJANGO_SETTINGS_MODULE=config.settings.production

# Base de datos PostgreSQL
# Opción A: URL completa (recomendada si usas un servicio administrado)
DATABASE_URL=postgres://USUARIO:CONTRASEÑA@HOST:5432/BD_RRHH
# Opción B: Variables individuales (usadas si DATABASE_URL no está definida)
DB_NAME=BD_RRHH
DB_USER=postgres
DB_PASSWORD=123456
DB_HOST=db
DB_PORT=5432

# Redis (cola y caché)
REDIS_URL=redis://redis:6379/0

# CORS — dominio(s) del frontend separados por coma
CORS_ALLOWED_ORIGINS=https://tudominio.com,https://www.tudominio.com

# Email SMTP (Gmail con App Password recomendado)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=francueva30@gmail.com 
EMAIL_HOST_PASSWORD=fbbi_pmec_gahy_aoos
DEFAULT_FROM_EMAIL=NexusRH <noreply@tudominio.com>

# Seguridad HTTPS (activa cuando el dominio tenga SSL)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Opcionales (tienen valores por defecto seguros)
JWT_ACCESS_LIFETIME_MINUTES=60
JWT_REFRESH_LIFETIME_DAYS=7
MAX_LOGIN_ATTEMPTS=5
TRIAL_PERIOD_DAYS=30
QR_EXPIRY_DEFAULT_MINUTES=480
